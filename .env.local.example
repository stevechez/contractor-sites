# Copy to .env.local for development; set these in Vercel Production and redeploy.
# Never use NEXT_PUBLIC_ for any of these credentials or private destinations.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Resend owner alerts (works for direct Airtable and Make-accepted leads).
RESEND_API_KEY=
CONTRACTOR_ALERT_EMAIL=
# Testing: use your Resend account email as the recipient with this sender.
# Production: replace with a sender on your verified Resend domain.
RESEND_FROM_EMAIL="ApexPro Leads <onboarding@resend.dev>"
BUSINESS_NAME=ApexPro

# Optional Make primary dispatch; leave both empty for direct Airtable.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Optional legacy direct-path SMS; Resend owner alerts do not require Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
BUSINESS_OWNER_PHONE=
